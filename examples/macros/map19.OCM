@$ Testing STEP and MAP calculation in Mg-Na with new MQMQA model


new Y

set echo Y


r t
./MgNaCl-newmqmqa
Mg Na Cl


@&


l sh a



@$
@$ This database has no gas phase but multiple solid phases
@&


set c t=1300 p=1e5 n(mg)+n(na)=1 n(na)=0.4 ac(cl)=1


c e

l r 2


@$
@$ remove the degree of freedom of Cl by an activity of Cl
@&


l sh a

@$
@$

set ax 1 n(na)
0
1
.01


@$
@$ Calculate across the Mg-Na composition range at 1000 K
@&

step


@$
@&

plot
n(na)
y(mscl,*)


@$ 
@$ Plot the fractions of the liquid constituents
@&

set stat ph *=dor
set st ph mscl r3m nacl cl4mgna2 cl3mgna=e 0

c e

@$
@$ Suspend all but the relevant solid phases
@&

set ax 2 T
500
1500
10

@$
@$ Add a T axis to calculate a phase diagram
@&

map
Y



@$
@$ This mapping fails, to be investigated later

set inter

@&

plot
x(*,mg)
T

@$
@$ Plot the diagram, it ends at 1/3 as the rest is Cl
@&


plot
x(*,Mg)
T
extra axis-factor x 3

@$
@$ the "axis factor" eliminates the fraction of Cl
@&

@$
@&


set inter

@$
@&

@$
@&


@$
@&

@$
@&


set inter

